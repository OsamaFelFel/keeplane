# CoreDNS on the closed isolated network (close-network.sh). Cluster names are
# answered as on kind's default; every other name is answered "no such name"
# at once, with no forward, as a DNS server on an isolated network with no
# upstream does. A server failure would make the pods' resolvers stop at the
# first outside search domain, before trying the cluster name itself.
cluster.local:53 in-addr.arpa:53 ip6.arpa:53 {
    errors
    health {
       lameduck 5s
    }
    ready
    kubernetes cluster.local in-addr.arpa ip6.arpa {
       pods insecure
       fallthrough in-addr.arpa ip6.arpa
       ttl 30
    }
    prometheus :9153
    cache 30
    reload
    loadbalance
}
.:53 {
    errors
    template ANY ANY {
       rcode NXDOMAIN
    }
}
