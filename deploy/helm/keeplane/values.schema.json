{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keeplane integration chart values",
  "type": "object",
  "definitions": {
    "networkPolicyLabels": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "networkPolicyCidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]*/[0-9]{1,3})$"
    },
    "networkPolicyDestinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ports"],
        "properties": {
          "cidr": {"$ref": "#/definitions/networkPolicyCidr"},
          "namespaceSelector": {"$ref": "#/definitions/networkPolicyLabels"},
          "podSelector": {"$ref": "#/definitions/networkPolicyLabels"},
          "ports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    }
  },
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}}
          }
        },
        "resources": {"type": "object"},
        "cliSignIn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        },
        "personalDataDetection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["managed", "existing"]},
        "install": {"type": "boolean"},
        "url": {"type": "string"},
        "keysSecret": {"type": "string"},
        "caSecret": {"type": "string"},
        "copies": {"type": "integer", "minimum": 1, "maximum": 32},
        "copyUrls": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*|\\[[0-9A-Fa-f:.]+\\])(:[0-9]{1,5})?$"
          }
        },
        "extraVolumes": {"type": "array", "items": {"type": "object"}},
        "extraVolumeMounts": {"type": "array", "items": {"type": "object"}}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "existing"}}},
          "then": {
            "properties": {"install": {"const": false}, "url": {"minLength": 1}}
          }
        },
        {
          "if": {"properties": {"mode": {"const": "managed"}}},
          "then": {"properties": {"install": {"const": true}, "copyUrls": {"maxItems": 0}, "caSecret": {"maxLength": 0}}}
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gatewayIngressEnabled": {"type": "boolean"},
        "appIngressEnabled": {"type": "boolean"},
        "publicEntry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {"$ref": "#/definitions/networkPolicyLabels"},
            "podSelector": {"$ref": "#/definitions/networkPolicyLabels"}
          }
        },
        "egressEnabled": {"type": "boolean"},
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": {"$ref": "#/definitions/networkPolicyCidr"},
            "namespaceSelector": {"$ref": "#/definitions/networkPolicyLabels"},
            "podSelector": {"$ref": "#/definitions/networkPolicyLabels"}
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modelEndpoints": {"$ref": "#/definitions/networkPolicyDestinations"},
            "postgres": {"$ref": "#/definitions/networkPolicyDestinations"},
            "gatewayDatabase": {"$ref": "#/definitions/networkPolicyDestinations"},
            "suppliedGateway": {"$ref": "#/definitions/networkPolicyDestinations"},
            "runners": {"$ref": "#/definitions/networkPolicyDestinations"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
